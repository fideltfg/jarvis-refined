# JARVIS — secrets template
# ===================================================================
# Copy to ~/.config/jarvis/secrets.env and chmod 600. Credentials only.
# Everything else (theme, models, ports, endpoints, flags) belongs in
# ~/.config/jarvis/config.toml; see config.example.toml and
# docs/configuration.md. A legacy project-level .env.local is still read as a
# last-resort fallback, but new setups should not use it.
#
# EVERYTHING HERE IS OPTIONAL in the default (bridge) mode. The bridge
# authenticates off your Claude Code login, speech input can use browser
# recognition, and Kokoro speech output needs no credentials.
# Never commit a real key.

# OpenAI chat and, when ElevenLabs is unavailable, transcription.
# OPENAI_API_KEY=

# Optional key for the local OpenAI-compatible endpoint (local_url in config.toml).
# JARVIS_LOCAL_API_KEY=

# ElevenLabs speech and Scribe transcription. If you already have an elevenlabs
# MCP server in ~/.claude.json, the bridge reads the key from there instead.
# ELEVENLABS_API_KEY=

# Bearer token between the bridge and the agent service. Generate rather than
# invent it: npm run agents:token (writes this file for you).
# JARVIS_AGENTS_TOKEN=

# Authenticates a Chrome relay on another machine: npm run relay:token.
# JARVIS_RELAY_TOKEN=

# Tokens for endpoints in config.toml that name them with apiKeyEnv, e.g.
# RIGEL_GATEWAY_TOKEN=
# REMOTE_HOST_TOKEN=

# --- Browser-bundled credentials (direct mode only) ----------------------
# VITE_* values are compiled into the frontend and readable by anyone who can
# load it. Use only for a private local demo; bridge mode never needs them.
# VITE_ANTHROPIC_API_KEY=
# VITE_PICOVOICE_ACCESS_KEY=
# VITE_ELEVENLABS_API_KEY=

# Direct-mode MCP integrations (built-in servers). Extra servers go in
# config.toml as [[frontend.mcp_servers]] and can name a token variable here
# with token_env.
# VITE_ZAPIER_MCP_URL=
# VITE_PIPEDREAM_MCP_URL=
# VITE_NOTION_TOKEN=
# VITE_LINEAR_TOKEN=
# VITE_GITHUB_TOKEN=
# VITE_STRIPE_TOKEN=
# VITE_SENTRY_TOKEN=
# VITE_HOMEASSISTANT_MCP_URL=
# VITE_HOMEASSISTANT_TOKEN=
